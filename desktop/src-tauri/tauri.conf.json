{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Goloso POS",
  "version": "1.0.0",
  "identifier": "com.heladeriagoloso.pos",
  "build": {
    "frontendDist": "https://golosoheladeria.lovable.app",
    "devUrl": "https://golosoheladeria.lovable.app"
  },
  "app": {
    "windows": [
      {
        "title": "Goloso POS",
        "width": 1400,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 700,
        "resizable": true,
        "fullscreen": false,
        "decorations": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["msi", "nsis", "dmg", "appimage", "deb"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "publisher": "Heladería Goloso",
    "category": "Business",
    "shortDescription": "Sistema POS Heladería Goloso",
    "longDescription": "Punto de venta, cajas, tickets, historial y administración para Heladería Goloso.",
    "copyright": "© Heladería Goloso"
  }
}
