{
  "name": "goloso-print-server",
  "version": "2.11.0",
  "description": "Servidor local de impresión silenciosa para la impresora térmica del POS Heladería Goloso",
  "type": "module",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "test-print": "node -e \"fetch('http://localhost:3001/test').then(r=>r.json()).then(console.log)\"",
    "test-comanda": "node -e \"fetch('http://localhost:3001/test-comanda').then(r=>r.json()).then(console.log)\""
  },
  "dependencies": {
    "jimp": "^0.22.12"
  },
  "optionalDependencies": {
    "escpos": "^3.0.0-alpha.6",
    "escpos-usb": "^3.0.0-alpha.4"
  }
}
